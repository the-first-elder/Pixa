<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.pixa.tunnel</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CF_LOG</key>
    <string>/tmp/cf-tunnel.log</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- NOTE: the wrapper must live OUTSIDE ~/Documents: launchd cannot
       execute scripts under Documents (EPERM). ops/launchd/INSTALL.md
       copies scripts/pixa-tunnel-supervised.sh to ~/.config/pixa/. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/thefirstelder/.config/pixa/pixa-tunnel-supervised.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/pixa-tunnel-supervised.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pixa-tunnel-supervised.log</string>
</dict>
</plist>
