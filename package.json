{
  "name": "pixa",
  "version": "0.1.0",
  "private": true,
  "description": "Pixa — AI-powered spatial computing: phone video to explorable 3D environments",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@meta-sam/parser": "^0.1.0",
    "@playcanvas/splat-transform": "^3.10.3",
    "meshoptimizer": "^1.3.0",
    "openai": "^7.45.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.17"
  }
}
