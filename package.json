{
  "name": "pixa",
  "version": "0.1.0",
  "private": true,
  "description": "Pixa — AI-powered spatial computing: phone video to explorable 3D environments",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.10.3"
  }
}
