# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Meta Model API — single key unlocks all models. Docs: https://dev.meta.ai/docs
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
# Use Standard (non-contributor) models for private captures:
# Standard content is NOT used to train Meta models; Contributor content may be.
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_IMAGE_MODEL=muse-image-1.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage (local dev: filesystem; production: S3-compatible object storage)
STORAGE_DIR=./data
# DATABASE_URL=postgresql://... (production; dev uses SQLite/JSON file store — see docs/architecture.md)
