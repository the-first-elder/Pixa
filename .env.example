# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Meta Model API — single key unlocks all models. Docs: https://dev.meta.ai/docs
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
# Use Standard (non-contributor) models for private captures:
# Standard content is NOT used to train Meta models; Contributor content may be.
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_IMAGE_MODEL=muse-image-1.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Google OAuth via Auth.js). All three required to enable auth;
# without them the app runs in single-user local mode (see docs/auth-setup.md).
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (local dev: filesystem; production: S3-compatible object storage)
STORAGE_DIR=./data
# DATABASE_URL=postgresql://... (production; dev uses SQLite/JSON file store — see docs/architecture.md)

# Completion emails (Brevo). Unset = in-app notifications only, no mail.
# Key: app.brevo.com → SMTP & API → API Keys (free tier covers this volume).
# BREVO_API_KEY=
# Sender address — must be verified in Brevo (Senders & IPs).
# EMAIL_FROM=
# Display name on the sender, default "Pixa".
# EMAIL_FROM_NAME=Pixa
# Public base URL used for scene links in mail (default http://localhost:3000).
# APP_URL=https://pixa.autumn-test.workers.dev
# Render-only mode for testing (no mail sent, stamp untouched):
# EMAIL_DRY_RUN=1
